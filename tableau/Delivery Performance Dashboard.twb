  <dashboards>
    <dashboard name='Delivery Dashboard'>
      <repository-location derived-from='https://public.tableau.com/workbooks/DeliveryPerformanceDashboard_17952813858150/DeliveryDashboard?rev=' id='135357070' path='/workbooks/DeliveryPerformanceDashboard_17952813858150' revision='' />
      <style />
      <size maxheight='950' maxwidth='1400' minheight='950' minwidth='1400' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='2' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'>
            <zone h='6105' id='3' type-v2='text' w='100000' x='0' y='0'>
              <formatted-text>
                <run bold='true' fontsize='20'>Late deliveries are concentrated, not random</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='11'>Brazilian marketplace, 96,470 delivered orders, Olist public dataset</run>
              </formatted-text>
            </zone>
            <zone h='7053' id='4' param='horz' type-v2='layout-flow' w='100000' x='0' y='6105'>
              <zone h='7053' id='5' name='KPI Orders' w='25000' x='0' y='6105'>
                <layout-cache cell-count-w='1' type-h='cell' type-w='cell' />
              </zone>
              <zone h='7053' id='6' name='KPI Late' w='25000' x='25000' y='6105'>
                <layout-cache cell-count-w='1' type-h='cell' type-w='cell' />
              </zone>
              <zone h='7053' id='7' name='KPI Review' w='25000' x='50000' y='6105'>
                <layout-cache cell-count-w='1' type-h='cell' type-w='cell' />
              </zone>
              <zone h='7053' id='8' name='KPI Problem' w='25000' x='75000' y='6105'>
                <layout-cache cell-count-w='1' type-h='cell' type-w='cell' />
              </zone>
            </zone>
            <zone h='47473' id='9' param='horz' type-v2='layout-flow' w='100000' x='0' y='13158'>
              <zone h='47473' id='10' name='Map' w='50964' x='0' y='13158'>
                <layout-cache minheight='238' minwidth='202' type-h='scalable' type-w='scalable' />
              </zone>
              <zone h='47473' id='11' name='Trend' w='49035' x='50964' y='13158'>
                <layout-cache minheight='293' minwidth='175' type-h='scalable' type-w='scalable' />
              </zone>
            </zone>
            <zone h='39368' id='12' param='horz' type-v2='layout-flow' w='100000' x='0' y='60631'>
              <zone h='39368' id='13' name='Sellers' w='53214' x='0' y='60631'>
                <layout-cache minheight='192' minwidth='146' type-h='scalable' type-w='scalable' />
              </zone>
              <zone h='39368' id='14' type-v2='text' w='46785' x='53214' y='60631'>
                <formatted-text>
                  <run bold='true' fontsize='12'>Three findings</run>
                  <run>Æ&#10;</run>
                  <run>Æ&#10;</run>
                  <run fontsize='10'>Geography. Rio de Janeiro runs at 12.1% late against 4.5% in São Paulo. Alagoas (21.4%) and Maranhão (17.4%) are the worst states.</run>
                  <run>Æ&#10;</run>
                  <run>Æ&#10;</run>
                  <run fontsize='10'>Timing. Late rate reached 12.4% in November 2017 and 19.0% in March 2018, when the average review fell to 3.81.</run>
                  <run>Æ&#10;</run>
                  <run>Æ&#10;</run>
                  <run fontsize='10'>Sellers. 78 of 425 sellers are late on more than 10% of orders and average 3.88 stars against 4.26 for reliable sellers.</run>
                  <run>Æ&#10;</run>
                  <run>Æ&#10;</run>
                  <run fontsize='10'>Source: Olist Brazilian e commerce public dataset. Monthly trend covers January 2017 to August 2018.</run>
                </formatted-text>
              </zone>
            </zone>
          </zone>
        </zone>
      </zones>
      <simple-id uuid='{77358506-906F-44E5-AE36-3D131ECE4784}' />
    </dashboard>
  </dashboards>
