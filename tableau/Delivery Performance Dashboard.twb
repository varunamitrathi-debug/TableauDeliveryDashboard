    <worksheet name='Map'>
      <repository-location derived-from='https://public.tableau.com/workbooks/DeliveryPerformanceDashboard_17952813858150/Map?rev=' id='135357067' path='/workbooks/DeliveryPerformanceDashboard_17952813858150' revision='' />
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Rio de Janeiro and the north east break the delivery promise</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='State performance' name='federated.state' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.state'>
            <column caption='Late orders' datatype='real' name='[Calculation 1001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders] * [late rate]' />
            </column>
            <column caption='Weighted late rate' datatype='real' default-format='p0.0%' name='[Calculation 1002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation 1001]) / SUM([orders])' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
            <column caption='Late rate' datatype='real' default-format='p0.0%' name='[late rate]' role='measure' type='quantitative' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[state name]' derivation='None' name='[none:state name:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[orders]' role='measure' type='quantitative' />
            <column caption='Brazilian state' datatype='string' name='[state name]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[orders]' derivation='Sum' name='[sum:orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation 1002]' derivation='User' name='[usr:Calculation 1002:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='map'>
            <format attr='washout' value='0.0' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-disallow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[federated.state].[usr:Calculation 1002:qk]' />
              <lod column='[federated.state].[none:country:nk]' />
              <lod column='[federated.state].[none:state name:nk]' />
              <tooltip column='[federated.state].[sum:orders:qk]' />
              <geometry column='[federated.state].[Geometry (generated)]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='false' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.state].[Latitude (generated)]</rows>
        <cols>[federated.state].[Longitude (generated)]</cols>
      </table>
      <simple-id uuid='{9208A3D7-706A-4A71-9574-CC48BDF2E39D}' />
    </worksheet>
