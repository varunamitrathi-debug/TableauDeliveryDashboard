      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Seller scorecard' name='federated.sellers' />
          </datasources>
          <datasource-dependencies datasource='federated.sellers'>
            <column datatype='real' name='[avg review]' role='measure' type='quantitative' />
            <column caption='Late rate' datatype='real' default-format='p0.0%' name='[late rate]' role='measure' type='quantitative' />
            <column-instance column='[seller]' derivation='None' name='[none:seller:nk]' pivot='key' type='nominal' />
            <column-instance column='[tier]' derivation='None' name='[none:tier:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[orders]' role='measure' type='quantitative' />
            <column datatype='string' name='[seller]' role='dimension' type='nominal' />
            <column-instance column='[avg review]' derivation='Sum' name='[sum:avg review:qk]' pivot='key' type='quantitative' />
            <column-instance column='[late rate]' derivation='Sum' name='[sum:late rate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[orders]' derivation='Sum' name='[sum:orders:qk]' pivot='key' type='quantitative' />
            <column caption='Tier' datatype='string' name='[tier]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
