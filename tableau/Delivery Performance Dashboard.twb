<?xml version='1.0' encoding='utf-8' ?>
<workbook source-build='2026.1.0' source-platform='mac' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences />
  <datasources>
    <datasource caption='State performance' inline='true' name='federated.stateperf' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='State performance' name='textscan.stateperf'>
            <connection class='textscan' directory='/Users/varunrathi/Documents/Tableau Delivery Dashboard' filename='state performance.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.stateperf' name='state performance.csv' table='[state performance#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','><column datatype='string' name='country' ordinal='0' /><column datatype='string' name='state' ordinal='1' /><column datatype='string' name='state name' ordinal='2' /><column datatype='integer' name='orders' ordinal='3' /><column datatype='real' name='gmv brl' ordinal='4' /><column datatype='real' name='avg delivery days' ordinal='5' /><column datatype='real' name='late rate' ordinal='6' /><column datatype='real' name='avg review' ordinal='7' /><column datatype='real' name='freight share of price' ordinal='8' /></columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column datatype='string' name='[country]' role='dimension' type='nominal' semantic-role='[Country].[Name]' />
<column datatype='string' name='[state name]' role='dimension' type='nominal' semantic-role='[State].[Name]' />
<column datatype='real' name='[late rate]' role='measure' type='quantitative' default-format='p0.0%' />
<column caption='Late orders' datatype='real' name='[Calculation 1001]' role='measure' type='quantitative'><calculation class='tableau' formula='[orders] * [late rate]' /></column>
<column caption='Weighted late rate' datatype='real' default-format='p0.0%' name='[Calculation 1002]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([Calculation 1001]) / SUM([orders])' /></column>
<column caption='Weighted review' datatype='real' default-format='n#,##0.00' name='[Calculation 1003]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([avg review] * [orders]) / SUM([orders])' /></column>
    </datasource>
    <datasource caption='Monthly delivery' inline='true' name='federated.monthly' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='Monthly delivery' name='textscan.monthly'>
            <connection class='textscan' directory='/Users/varunrathi/Documents/Tableau Delivery Dashboard' filename='monthly delivery.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.monthly' name='monthly delivery.csv' table='[monthly delivery#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','><column datatype='date' name='month' ordinal='0' /><column datatype='integer' name='orders' ordinal='1' /><column datatype='real' name='avg delivery days' ordinal='2' /><column datatype='real' name='late rate' ordinal='3' /><column datatype='real' name='avg review' ordinal='4' /></columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column datatype='real' name='[late rate]' role='measure' type='quantitative' default-format='p0.0%' />
    </datasource>
    <datasource caption='Seller scorecard' inline='true' name='federated.sellers' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='Seller scorecard' name='textscan.sellers'>
            <connection class='textscan' directory='/Users/varunrathi/Documents/Tableau Delivery Dashboard' filename='seller scorecard.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.sellers' name='seller scorecard.csv' table='[seller scorecard#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','><column datatype='string' name='seller' ordinal='0' /><column datatype='string' name='seller state' ordinal='1' /><column datatype='integer' name='orders' ordinal='2' /><column datatype='real' name='gmv brl' ordinal='3' /><column datatype='real' name='late rate' ordinal='4' /><column datatype='real' name='avg days to hand to carrier' ordinal='5' /><column datatype='real' name='avg review' ordinal='6' /><column datatype='string' name='tier' ordinal='7' /></columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column datatype='real' name='[late rate]' role='measure' type='quantitative' default-format='p0.0%' />
<column caption='Problem seller' datatype='integer' name='[Calculation 2001]' role='measure' type='quantitative'><calculation class='tableau' formula='IF [late rate] &gt; 0.10 THEN 1 ELSE 0 END' /></column>
<style><style-rule element='mark'><encoding attr='color' field='[none:tier:nk]' type='palette'>
      <map to='#c0392b'><bucket>&quot;Problem (over 10 pct)&quot;</bucket></map>
      <map to='#8c8c8c'><bucket>&quot;Watch (5 to 10 pct)&quot;</bucket></map>
      <map to='#d4d4d4'><bucket>&quot;On time (under 5 pct late)&quot;</bucket></map>
    </encoding></style-rule></style>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='KPI Orders'>
      <layout-options><title><formatted-text><run bold='true' fontsize='12'>Delivered orders</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource name='federated.stateperf' /></datasources>
          <datasource-dependencies datasource='federated.stateperf'><column datatype='integer' name='[orders]' role='measure' type='quantitative' /><column datatype='real' name='[late rate]' role='measure' type='quantitative' default-format='p0.0%' /><column datatype='real' name='[avg review]' role='measure' type='quantitative' /><column-instance column='[orders]' derivation='Sum' name='[sum:orders:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style><style-rule element='cell'><format attr='font-size' value='26' /><format attr='font-weight' value='bold' /><format attr='text-align' value='center' /></style-rule></style>
        <panes><pane><view><breakdown value='auto' /></view><mark class='Text' /><encodings><text column='[federated.stateperf].[sum:orders:qk]' /></encodings>
          <style><style-rule element='mark'><format attr='mark-labels-show' value='false' /></style-rule></style></pane></panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name='KPI Late'>
      <layout-options><title><formatted-text><run bold='true' fontsize='12'>Late delivery rate</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource name='federated.stateperf' /></datasources>
          <datasource-dependencies datasource='federated.stateperf'><column datatype='integer' name='[orders]' role='measure' type='quantitative' /><column datatype='real' name='[late rate]' role='measure' type='quantitative' default-format='p0.0%' /><column datatype='real' name='[avg review]' role='measure' type='quantitative' /><column caption='Late orders' datatype='real' name='[Calculation 1001]' role='measure' type='quantitative'><calculation class='tableau' formula='[orders] * [late rate]' /></column><column caption='Weighted late rate' datatype='real' default-format='p0.0%' name='[Calculation 1002]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([Calculation 1001]) / SUM([orders])' /></column><column caption='Weighted review' datatype='real' default-format='n#,##0.00' name='[Calculation 1003]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([avg review] * [orders]) / SUM([orders])' /></column><column-instance column='[Calculation 1002]' derivation='User' name='[usr:Calculation 1002:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style><style-rule element='cell'><format attr='font-size' value='26' /><format attr='font-weight' value='bold' /><format attr='text-align' value='center' /></style-rule></style>
        <panes><pane><view><breakdown value='auto' /></view><mark class='Text' /><encodings><text column='[federated.stateperf].[usr:Calculation 1002:qk]' /></encodings>
          <style><style-rule element='mark'><format attr='mark-labels-show' value='false' /></style-rule></style></pane></panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name='KPI Review'>
      <layout-options><title><formatted-text><run bold='true' fontsize='12'>Average review score</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource name='federated.stateperf' /></datasources>
          <datasource-dependencies datasource='federated.stateperf'><column datatype='integer' name='[orders]' role='measure' type='quantitative' /><column datatype='real' name='[late rate]' role='measure' type='quantitative' default-format='p0.0%' /><column datatype='real' name='[avg review]' role='measure' type='quantitative' /><column caption='Late orders' datatype='real' name='[Calculation 1001]' role='measure' type='quantitative'><calculation class='tableau' formula='[orders] * [late rate]' /></column><column caption='Weighted late rate' datatype='real' default-format='p0.0%' name='[Calculation 1002]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([Calculation 1001]) / SUM([orders])' /></column><column caption='Weighted review' datatype='real' default-format='n#,##0.00' name='[Calculation 1003]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([avg review] * [orders]) / SUM([orders])' /></column><column-instance column='[Calculation 1003]' derivation='User' name='[usr:Calculation 1003:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style><style-rule element='cell'><format attr='font-size' value='26' /><format attr='font-weight' value='bold' /><format attr='text-align' value='center' /></style-rule></style>
        <panes><pane><view><breakdown value='auto' /></view><mark class='Text' /><encodings><text column='[federated.stateperf].[usr:Calculation 1003:qk]' /></encodings>
          <style><style-rule element='mark'><format attr='mark-labels-show' value='false' /></style-rule></style></pane></panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name='KPI Problem'>
      <layout-options><title><formatted-text><run bold='true' fontsize='12'>Sellers over 10% late</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource name='federated.sellers' /></datasources>
          <datasource-dependencies datasource='federated.sellers'><column datatype='real' name='[late rate]' role='measure' type='quantitative' /><column caption='Problem seller' datatype='integer' name='[Calculation 2001]' role='measure' type='quantitative'><calculation class='tableau' formula='IF [late rate] &gt; 0.10 THEN 1 ELSE 0 END' /></column><column-instance column='[Calculation 2001]' derivation='Sum' name='[sum:Calculation 2001:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style><style-rule element='cell'><format attr='font-size' value='26' /><format attr='font-weight' value='bold' /><format attr='text-align' value='center' /></style-rule></style>
        <panes><pane><view><breakdown value='auto' /></view><mark class='Text' /><encodings><text column='[federated.sellers].[sum:Calculation 2001:qk]' /></encodings>
          <style><style-rule element='mark'><format attr='mark-labels-show' value='false' /></style-rule></style></pane></panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name='Map'>
      <layout-options><title><formatted-text><run bold='true' fontsize='12'>Rio de Janeiro and the north east break the delivery promise</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource name='federated.stateperf' /></datasources>
          <datasource-dependencies datasource='federated.stateperf'><column datatype='string' name='[country]' role='dimension' type='nominal' semantic-role='[Country].[Name]' /><column datatype='string' name='[state name]' role='dimension' type='nominal' semantic-role='[State].[Name]' /><column datatype='integer' name='[orders]' role='measure' type='quantitative' /><column datatype='real' name='[late rate]' role='measure' type='quantitative' default-format='p0.0%' /><column datatype='real' name='[avg review]' role='measure' type='quantitative' /><column caption='Late orders' datatype='real' name='[Calculation 1001]' role='measure' type='quantitative'><calculation class='tableau' formula='[orders] * [late rate]' /></column><column caption='Weighted late rate' datatype='real' default-format='p0.0%' name='[Calculation 1002]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([Calculation 1001]) / SUM([orders])' /></column><column caption='Weighted review' datatype='real' default-format='n#,##0.00' name='[Calculation 1003]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([avg review] * [orders]) / SUM([orders])' /></column><column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' /><column-instance column='[state name]' derivation='None' name='[none:state name:nk]' pivot='key' type='nominal' /><column-instance column='[Calculation 1002]' derivation='User' name='[usr:Calculation 1002:qk]' pivot='key' type='quantitative' /><column-instance column='[orders]' derivation='Sum' name='[sum:orders:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style></style>
        <panes><pane><view><breakdown value='auto' /></view><mark class='Multipolygon' /><encodings><color column='[federated.stateperf].[usr:Calculation 1002:qk]' /><lod column='[federated.stateperf].[none:country:nk]' /><lod column='[federated.stateperf].[none:state name:nk]' /><tooltip column='[federated.stateperf].[sum:orders:qk]' /></encodings>
          <style><style-rule element='mark'><format attr='mark-labels-show' value='false' /></style-rule></style></pane></panes>
        <rows>[federated.stateperf].[Latitude (generated)]</rows>
        <cols>[federated.stateperf].[Longitude (generated)]</cols>
      </table>
    </worksheet>
    <worksheet name='Trend'>
      <layout-options><title><formatted-text><run bold='true' fontsize='12'>Late rate spiked at Black Friday 2017 and in February to March 2018</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource name='federated.monthly' /></datasources>
          <datasource-dependencies datasource='federated.monthly'><column datatype='date' name='[month]' role='dimension' type='ordinal' /><column datatype='real' name='[late rate]' role='measure' type='quantitative' default-format='p0.0%' /><column datatype='real' name='[avg review]' role='measure' type='quantitative' /><column-instance column='[month]' derivation='Month-Trunc' name='[tmn:month:qk]' pivot='key' type='quantitative' /><column-instance column='[late rate]' derivation='Sum' name='[sum:late rate:qk]' pivot='key' type='quantitative' /><column-instance column='[avg review]' derivation='Sum' name='[sum:avg review:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style></style>
        <panes><pane><view><breakdown value='auto' /></view><mark class='Line' /><encodings></encodings>
          <style><style-rule element='mark'><format attr='mark-labels-show' value='false' /></style-rule></style></pane></panes>
        <rows>([federated.monthly].[sum:late rate:qk] + [federated.monthly].[sum:avg review:qk])</rows>
        <cols>[federated.monthly].[tmn:month:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Sellers'>
      <layout-options><title><formatted-text><run bold='true' fontsize='12'>78 sellers over 10% late average 3.88 stars against 4.26 for reliable sellers</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource name='federated.sellers' /></datasources>
          <datasource-dependencies datasource='federated.sellers'><column datatype='string' name='[seller]' role='dimension' type='nominal' /><column datatype='string' name='[tier]' role='dimension' type='nominal' /><column datatype='real' name='[late rate]' role='measure' type='quantitative' default-format='p0.0%' /><column datatype='real' name='[avg review]' role='measure' type='quantitative' /><column datatype='integer' name='[orders]' role='measure' type='quantitative' /><column-instance column='[seller]' derivation='None' name='[none:seller:nk]' pivot='key' type='nominal' /><column-instance column='[tier]' derivation='None' name='[none:tier:nk]' pivot='key' type='nominal' /><column-instance column='[late rate]' derivation='Sum' name='[sum:late rate:qk]' pivot='key' type='quantitative' /><column-instance column='[avg review]' derivation='Sum' name='[sum:avg review:qk]' pivot='key' type='quantitative' /><column-instance column='[orders]' derivation='Sum' name='[sum:orders:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style></style>
        <panes><pane><view><breakdown value='auto' /></view><mark class='Circle' /><encodings><color column='[federated.sellers].[none:tier:nk]' /><size column='[federated.sellers].[sum:orders:qk]' /><lod column='[federated.sellers].[none:seller:nk]' /></encodings>
          <style><style-rule element='mark'><format attr='mark-labels-show' value='false' /></style-rule></style></pane></panes>
        <rows>[federated.sellers].[sum:avg review:qk]</rows>
        <cols>[federated.sellers].[sum:late rate:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Delivery Dashboard'>
      <style />
      <size maxheight='950' maxwidth='1400' minheight='950' minwidth='1400' sizing-mode='fixed' />
      <zones><zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'><zone h='100000' id='2' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'><zone h='9000' id='3' type-v2='text' w='100000' x='0' y='0'><formatted-text><run bold='true' fontsize='20'>Late deliveries are concentrated, not random</run><run>&#10;</run><run fontcolor='#555555' fontsize='11'>Brazilian marketplace, 96,470 delivered orders, Olist public dataset</run></formatted-text></zone><zone h='11000' id='4' param='horz' type-v2='layout-flow' w='100000' x='0' y='9000'><zone h='11000' id='5' name='KPI Orders' w='25000' x='0' y='9000' /><zone h='11000' id='6' name='KPI Late' w='25000' x='25000' y='9000' /><zone h='11000' id='7' name='KPI Review' w='25000' x='50000' y='9000' /><zone h='11000' id='8' name='KPI Problem' w='25000' x='75000' y='9000' /></zone><zone h='42000' id='9' param='horz' type-v2='layout-flow' w='100000' x='0' y='20000'><zone h='42000' id='10' name='Map' w='42000' x='0' y='20000' /><zone h='42000' id='11' name='Trend' w='58000' x='42000' y='20000' /></zone><zone h='38000' id='12' param='horz' type-v2='layout-flow' w='100000' x='0' y='62000'><zone h='38000' id='13' name='Sellers' w='64000' x='0' y='62000' /><zone h='38000' id='14' type-v2='text' w='36000' x='64000' y='62000'><formatted-text><run fontsize='11'>Three findings&#10;&#10;Geography. Rio de Janeiro runs at 12.1% late against 4.5% in São Paulo; Alagoas (21.4%) and Maranhão (17.4%) are the worst states.&#10;&#10;Timing. Late rate reached 12.4% in November 2017 and 19.0% in March 2018, when the average review fell to 3.81.&#10;&#10;Sellers. 78 of 425 sellers are late on more than 10% of orders and average 3.88 stars against 4.26 for reliable sellers.&#10;&#10;Source: Olist Brazilian e commerce public dataset. Monthly trend covers January 2017 to August 2018.</run></formatted-text></zone></zone></zone></zone></zones>
    </dashboard>
  </dashboards>
  <windows source-height='30'><window class='worksheet' name='KPI Orders'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><viewpoint><zoom type='entire-view' /></viewpoint></window><window class='worksheet' name='KPI Late'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><viewpoint><zoom type='entire-view' /></viewpoint></window><window class='worksheet' name='KPI Review'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><viewpoint><zoom type='entire-view' /></viewpoint></window><window class='worksheet' name='KPI Problem'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><viewpoint><zoom type='entire-view' /></viewpoint></window><window class='worksheet' name='Map'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><viewpoint><zoom type='entire-view' /></viewpoint></window><window class='worksheet' name='Trend'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><viewpoint><zoom type='entire-view' /></viewpoint></window><window class='worksheet' name='Sellers'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><viewpoint><zoom type='entire-view' /></viewpoint></window><window class='dashboard' maximized='true' name='Delivery Dashboard'><viewpoints><viewpoint name='KPI Orders'><zoom type='entire-view' /></viewpoint><viewpoint name='KPI Late'><zoom type='entire-view' /></viewpoint><viewpoint name='KPI Review'><zoom type='entire-view' /></viewpoint><viewpoint name='KPI Problem'><zoom type='entire-view' /></viewpoint><viewpoint name='Map'><zoom type='entire-view' /></viewpoint><viewpoint name='Trend'><zoom type='entire-view' /></viewpoint><viewpoint name='Sellers'><zoom type='entire-view' /></viewpoint></viewpoints><active id='-1' /></window></windows>
  
</workbook>
