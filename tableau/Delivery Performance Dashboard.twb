      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Late delivery rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='State performance' name='federated.state' />
          </datasources>
          <datasource-dependencies datasource='federated.state'>
            <column caption='Late orders' datatype='real' name='[Calculation 1001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders] * [late rate]' />
            </column>
            <column caption='Weighted late rate' datatype='real' default-format='p0.0%' name='[Calculation 1002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation 1001]) / SUM([orders])' />
            </column>
            <column caption='Late rate' datatype='real' default-format='p0.0%' name='[late rate]' role='measure' type='quantitative' />
            <column datatype='integer' name='[orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation 1002]' derivation='User' name='[usr:Calculation 1002:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='font-size' value='26' />
            <format attr='font-weight' value='bold' />
            <format attr='text-align' value='center' />
