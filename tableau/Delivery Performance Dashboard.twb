    <worksheet name='Trend'>
      <repository-location derived-from='https://public.tableau.com/workbooks/DeliveryPerformanceDashboard_17952813858150/Trend?rev=' id='135357068' path='/workbooks/DeliveryPerformanceDashboard_17952813858150' revision='' />
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Late rate spiked at Black Friday 2017 and in February to March 2018</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Monthly delivery' name='federated.monthly' />
          </datasources>
          <datasource-dependencies datasource='federated.monthly'>
            <column caption='Average review' datatype='real' name='[avg review]' role='measure' type='quantitative' />
            <column caption='Late rate' datatype='real' default-format='p0.0%' name='[late rate]' role='measure' type='quantitative' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[avg review]' derivation='Sum' name='[sum:avg review:qk]' pivot='key' type='quantitative' />
            <column-instance column='[late rate]' derivation='Sum' name='[sum:late rate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[month]' derivation='Month-Trunc' name='[tmn:month:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.monthly].[tmn:month:qk]' scope='cols' value='Month' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-disallow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='false' />
              </style-rule>
            </style>
          </pane>
          <pane id='1' selection-relaxation-option='selection-relaxation-disallow' y-axis-name='[federated.monthly].[sum:late rate:qk]'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='false' />
              </style-rule>
            </style>
          </pane>
          <pane id='2' selection-relaxation-option='selection-relaxation-disallow' y-axis-name='[federated.monthly].[sum:avg review:qk]'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='false' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>([federated.monthly].[sum:late rate:qk] + [federated.monthly].[sum:avg review:qk])</rows>
        <cols>[federated.monthly].[tmn:month:qk]</cols>
      </table>
      <simple-id uuid='{FDDE5B6A-B61A-405D-AF56-9EB8F0C05DDF}' />
    </worksheet>
